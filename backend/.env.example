# AI Provider: "openai" or "gemini"
AI_PROVIDER=openai

# OpenAI API Key (if using OpenAI)
OPENAI_API_KEY=sk-your-openai-api-key-here

# Google Gemini API Key (if using Gemini)
GEMINI_API_KEY=your-gemini-api-key-here

# Server
HOST=0.0.0.0
PORT=8000

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:5173

# Database (async SQLAlchemy URL)
# Default: sqlite+aiosqlite:///backend/stylemate.db
DB_URL=sqlite+aiosqlite:///./stylemate.db

# If true, app startup will run SQLAlchemy create_all()
# Recommended for local quick test only. Keep false when using Alembic.
AUTO_CREATE_TABLES=false

# Admin auth (hash-based)
# Example: SHA-256 of "0000"
ADMIN_PASSWORD_HASH=9af15b336e6a9619928537df30b2e6a2376569fcf9d7e773eccede65606529a0
# Optional salt when using ADMIN_PASSWORD_HASH = sha256(salt + password)
ADMIN_PASSWORD_SALT=
# Optional admin session expiration time (minutes)
ADMIN_SESSION_TTL_MINUTES=480
